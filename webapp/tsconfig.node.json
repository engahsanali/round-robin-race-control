{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "netlify/functions/**/*.ts", "src/race-layout.ts", "src/types.ts", "src/domain.ts", "src/results.ts", "src/data/*.json"]
}
