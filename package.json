{
  "name": "round-robin-race-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test",
    "test:pro:e2e": "cross-env RR3_PRO_GATE=1 RR3_PRO_URL=http://127.0.0.1:4387 RR3_PRO_PORT=4387 playwright test pro- --project=chromium --workers=1",
    "verify:meet": "node scripts/verify-meet-build.mjs",
    "test:meet:e2e": "cross-env RR3_MEET_GATE=1 RR3_MEET_URL=http://127.0.0.1:4399 RR3_MEET_PORT=4399 playwright test meet-workbook meet-release --project=chromium --workers=1 --reporter=line",
    "test:meet:workbook:e2e": "pnpm test:meet:e2e",
    "test:meet:live": "cross-env RR3_MEET_LIVE_E2E=1 playwright test meet-live --project=chromium --workers=1 --reporter=line",
    "test:meet:deployed": "cross-env RR3_MEET_DEPLOYED_E2E=1 playwright test meet-deployed --project=chromium --workers=1 --reporter=line"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "cross-env": "^10.0.0",
    "fast-check": "^4.3.0",
    "supabase": "2.114.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
