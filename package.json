{
  "name": "round-robin-race-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test",
    "test:pro:e2e": "cross-env RR3_PRO_GATE=1 RR3_PRO_URL=http://127.0.0.1:4387 RR3_PRO_PORT=4387 playwright test pro- --project=chromium --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "cross-env": "^10.0.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
